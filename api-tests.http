# ========================================
# 15. ADVANCED ODATA QUERIES
# ========================================

### Count Total Employees
GET http://localhost:4005/employee/Employees/$count

### Get Employees with Pagination
GET http://localhost:4005/employee/Employees?$skip=2&$top=3

### Order Employees by Hire Date
GET http://localhost:4005/employee/Employees?$orderby=hireDate desc

### Complex Filter - Active Employees in IT Department
GET http://localhost:4005/employee/Employees?$filter=status eq 'Active' and department_ID eq '2'

### Filter by Salary Range
GET http://localhost:4005/employee/Employees?$filter=salary ge 70000 and salary le 100000

### Get High Performers (if performance reviews exist)
GET http://localhost:4005/employee/PerformanceReviews?$filter=overallRating ge 4

### Get Employees by Employment Type
GET http://localhost:4005/employee/Employees?$filter=employmentType eq 'Full-Time'

### Search by Multiple Criteria
GET http://localhost:4005/employee/Employees?$filter=contains(workLocation,'Remote') and salary gt 80000

# ========================================
# 16. CALCULATED FIELDS TESTING
# ========================================

### Test Calculated Fields (fullName, age, yearsOfService)
GET http://localhost:4005/employee/Employees?$select=firstName,lastName,fullName,dateOfBirth,age,hireDate,yearsOfService

### Test Leave Balance Calculation (available = allocated + carriedForward - used)
GET http://localhost:4005/employee/LeaveBalances?$select=employee_ID,leaveType_ID,allocated,used,carriedForward,available

### Test Department Metrics (employeeCount, averageRating)
GET http://localhost:4005/employee/Departments?$select=name,employeeCount,averageRating,budget

# ========================================
# 11. ERROR TESTING
# ========================================

### Test Invalid Employee Creation (Missing Required Field)
POST http://localhost:4004/employee/Employees
Content-Type: application/json

{
  "firstName": "Invalid",
  "phone": "+1-555-ERROR"
  // Missing required fields: lastName, email, hireDate
}

### Test Invalid ID Access
GET http://localhost:4004/employee/Employees(999999)

### Test Invalid Filter
GET http://localhost:4004/employee/Employees?$filter=invalidField eq 'test'

# ========================================
# 12. BATCH OPERATIONS (Advanced)
# ========================================

### Batch Request - Multiple Operations
POST http://localhost:4004/employee/$batch
Content-Type: multipart/mixed; boundary=batch_123

--batch_123
Content-Type: application/http

GET Employees HTTP/1.1
Host: localhost:4004

--batch_123
Content-Type: application/http

GET Departments HTTP/1.1
Host: localhost:4004

--batch_123--
