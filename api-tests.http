POST http://localhost:4005/employee/LeaveRequests
Content-Type: application/json

{
  "employee_ID": "1",
  "leaveType_ID": "1", 
  "startDate": "2023-09-18",
  "endDate": "2023-09-22",
  "reason": "Family vacation - enhanced request",
  "isEmergency": false,
  "delegatedTo_ID": "2"
}

